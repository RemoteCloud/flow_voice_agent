# Copy to deploy/.env (chmod 600). Never commit the real file.
# Generate secrets with:  openssl rand -base64 32 | tr '+/' '-_'
HUB_SECRET=
SESSION_SECRET=

# Vessel identity, shown in the UI and audit
VESSEL_ID=color-fantasy

# Maranics tenant + API gateway host (Flows / Templates APIs live under {host}/app/…)
#   preprod  gateway https://api.cloud.preprod.maranics-staging.com
#            UserManagement https://usermanagement.cloud.preprod.maranics-staging.com
#   cloud    gateway https://api.app.fringeflow.com, UserManagement https://administration.app.fringeflow.com
HUB_TENANT=
HUB_MARANICS_HOST=https://api.cloud.preprod.maranics-staging.com

# Sign-in with Maranics UserManagement (OIDC). Register Flow Voice in UserManagement as a
# confidential external application with the redirect URI
#   {HUB_PUBLIC_URL}/api/auth/callback      (byte-exact, e.g. https://flow-voice.vessel.local:8443/api/auth/callback)
# and the scopes openid email profile offline_access, then paste its client id + secret here.
HUB_PUBLIC_URL=https://flow-voice.vessel.local:8443
HUB_OIDC_ISSUER=https://usermanagement.cloud.preprod.maranics-staging.com/<tenant>
HUB_OIDC_CLIENT_ID=
HUB_OIDC_CLIENT_SECRET=

# Integrations (POST /v1/prompts, /v1/runs/trigger): service bearer tokens and/or webhook HMAC secrets
SERVICE_TOKENS=
WEBHOOK_SECRET=

# Speech. Default: STT + TTS run on the device (browser Web Speech API / Android).
# Speech on the hub (compose profile `speech`: whisper.cpp + Piper, see docker-compose.yml):
#   backup recogniser — used by browsers without one, and by stations set to "speech is recognised on the hub"
#STT_BACKUP_ENDPOINT=http://stt:8080
#STT_BACKUP_MODEL=whisper-1
#   one voice for every computer, in the checklist language (TTS_VOICES=no=no_NO-talesyntese-medium,… overrides)
#TTS_ENDPOINT=http://tts:5000
# Recognition on the hub for every device (OpenAI-compatible /v1/audio/transcriptions):
#STT_ENDPOINT=http://stt:8080
#STT_MODEL=whisper-1
#STT_API_KEY=

# Recording answers for training (Admin → Stations → "Record answers for training", off by default).
# Clips (16 kHz WAV + JSON with flow, item, transcript, outcome) queue in <data>/captures/ and are uploaded to any
# S3-compatible bucket; without a bucket they stay in the folder (oldest dropped above CAPTURE_MAX_MB).
#CAPTURE_S3_BUCKET=flow-voice-training
#CAPTURE_S3_REGION=eu-north-1
#CAPTURE_S3_ENDPOINT=            # empty = AWS; MinIO / R2 / other: its URL (path-style by default)
#CAPTURE_S3_PREFIX=flow-voice
#CAPTURE_S3_ACCESS_KEY_ID=
#CAPTURE_S3_SECRET_ACCESS_KEY=
#CAPTURE_S3_PATH_STYLE=
#CAPTURE_MAX_MB=2048

# Dialogue policy
#LISTEN_MS=8000
#CONFIRM_MS=10000
#EXCHANGE_MS=60000
#RETRIES=2
#MAX_PAST_HOURS=12
#TZ_MODE=utc            # utc | local (with TZ=Europe/Oslo)
#DEFAULT_LANGUAGE=en
#READ_NOTICES=0
# Live sync with the Flow app: stats-only read per open run, ms (0 = no polling, push over /v1/flows/{id}/changed only)
#SYNC_POLL_MS=3000

# Dev only — no identity provider needed: a "Sign in as …" button plus a static Maranics token
#DEV_USER=Bridge Officer
#DEV_MARANICS_TOKEN=t0k3n

LOG_LEVEL=info

# Password of the central admin area (/central) where tenants are added. 12 characters or more.
CENTRAL_PASSWORD=
